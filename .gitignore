# Resumable benchmark local input cache and SQLite state
results/runs/**/input/
results/runs/**/state.sqlite3*
results/runs/**/run.log
results/runs/**/.runner.lock

# Version the frozen September 7 inputs and checkpoint for reproducible resumes.
!results/runs/fontbench-2026-09-07/input/
!results/runs/fontbench-2026-09-07/input/**
!results/runs/fontbench-2026-09-07/state.sqlite3

# Released run ledgers are repository artifacts; transient SQLite files stay ignored.
!results/runs/[0-9]*.[0-9]*.[0-9]*/**/state.sqlite3

# Offline checks and development generations never enter the published run history.
results/runs/**/mock-*/
dataset/candidate-rendered/
dataset/candidate-harbor/
